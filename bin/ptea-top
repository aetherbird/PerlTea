#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use PerlTea;
use PerlTea::App::Top;

# ptea-top - installed command for the htop-style process viewer.
#
# Run without arguments for a live process list (spawns `ps aux`).
# Set PERLTEA_PS_FIXTURE=/path/to/ps.txt for deterministic offline operation.
# The kill action uses PERLTEA_KILL_CMD (default `kill`) so it is never
# destructive in tests. `q` quits; `/` filters; `k` kills the selected process.

my $app = PerlTea::App::Top->new;
PerlTea->new( model => $app, alt_screen => 1 )->run;
