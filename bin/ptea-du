#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use PerlTea;
use PerlTea::App::Du;

# ptea-du - installed command for the disk-usage explorer.
#
# Usage: ptea-du [path]   (default: the current directory)
#
# Scans the tree, shows each entry's aggregate size sorted largest-first.
# Enter / l / Right descends into the selected directory; u / h / Left /
# Backspace returns to the parent; `q` quits.

my $path = @ARGV ? $ARGV[0] : '.';
my $app = PerlTea::App::Du->new( path => $path );
PerlTea->new( model => $app, alt_screen => 1 )->run;
