#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use PerlTea;
use PerlTea::App::GitDash;

# ptea-gitdash — installed command for the GitDash dashboard.
# Renders a multi-pane dashboard for the current repository (or a path given as
# the first argument). Tab cycles focus, r refreshes asynchronously, and q quits.
# The terminal is restored on exit.
#
# Usage: ptea-gitdash [repo-path]

my $repo = shift @ARGV || '.';

PerlTea->new( model => PerlTea::App::GitDash->new( repo => $repo ), alt_screen => 1 )
    ->run;
