#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use PerlTea;
use PerlTea::App::Svc;

# ptea-svc - installed command for the systemd/service manager.
#
# Run without arguments for a live unit list (spawns `systemctl list-units`).
# Set PERLTEA_SYSTEMCTL_FIXTURE=/path/to/units.txt for deterministic offline
# operation.  Start/stop actions use PERLTEA_SYSTEMCTL_CMD (default `systemctl`)
# so they are never destructive in tests.  `q` quits.

my $app = PerlTea::App::Svc->new;
PerlTea->new( model => $app, alt_screen => 1 )->run;
